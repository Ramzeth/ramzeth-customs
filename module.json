{
  "id": "ramzeth-customs",
  "title": "Ramzeth Customs",
  "description": "Personal library: prefabs, sounds and custom content.",
  "version": "#{VERSION}#",
  "authors": [
    { "name": "Ramzeth" }
  ],
  "url": "#{URL}#",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#",
  "compatibility": {
    "minimum": "14",
    "verified": "14.367"
  },
  "esmodules": ["scripts/main.js"],
  "styles": ["styles/main.css"],
  "socket": true,
  "relationships": {
      "requires": [
          { "id": "lib-wrapper", "type": "module" },
          {
              "id": "sequencer",
              "type": "module",
              "reason": "Plays the spells' sounds and effects for everyone at the table, timed against each other."
          }
      ],
      "recommends": [
          {
              "id": "wall-height",
              "type": "module",
              "reason": "Gives the walls of Sliding Blocks a height, so a levitated block can be passed beneath."
          },
          {
              "id": "dice-so-nice",
              "type": "module",
              "reason": "A fireball, or an Ember Hussar's blast, waits for its damage dice to land before it goes off."
          },
          {
              "id": "pf2e-auto-action-tracker",
              "type": "module",
              "reason": "Sustaining Ember Doppelgänger posts its card again for the next blast, and letting it lapse ends the spell."
          }
      ]
  },
  "packs": [
    {
      "name": "ramzeth-prefabs",
      "label": "Ramzeth Prefabs",
      "path": "packs/ramzeth-prefabs",
      "type": "JournalEntry",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "ramzeth-sounds",
      "label": "Ramzeth Sounds",
      "path": "packs/ramzeth-sounds",
      "type": "Playlist",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "ramzeth-spells",
      "label": "Ramzeth Spells",
      "path": "packs/ramzeth-spells",
      "type": "Item",
      "system": "pf2e",
      "ownership": { "PLAYER": "OBSERVER", "TRUSTED": "OBSERVER", "ASSISTANT": "OWNER", "GAMEMASTER": "OWNER" }
    }
  ],
  "packFolders": [
    {
      "name": "Ramzeth Customs",
      "sorting": "m",
      "color": "#6b4fa8",
      "packs": ["ramzeth-prefabs", "ramzeth-sounds", "ramzeth-spells"]
    }
  ]
}
